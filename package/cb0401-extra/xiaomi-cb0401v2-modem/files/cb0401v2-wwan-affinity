#!/bin/sh
# Xiaomi CB0401 / CB0401V2: the modem's receive work on one core, everything
# that hands its packets on on the other. Idempotent; run after the modem
# binds (cb0401v2-pcie-modem), on every QMAP link ModemManager creates
# (hotplug.d/net/30-cb0401-rmnet-link, with the link's name) and by hand.
# Without arguments every existing qmapmux* link is done.
#
# 1. The modem's MHI interrupts (the MSI vectors of the PCIe device, listed
#    under msi_irqs/) go to the last CPU. The GIC leaves them on CPU0, where
#    the NSS and Wi-Fi work lands too, and the modem receive path saturates
#    that core at ~380 Mbit/s while CPU1 idles; measured: same CPU-s/GB, the
#    busy core ~54 % -> ~19 % at the same rate, which lifts the modem path's
#    ceiling to ~900 Mbit/s (commit 40f6a444c6). A pin survives the MHI
#    recovery and reset paths (the vectors live as long as the device is
#    bound), so this normally finds them in place and re-pins only strays -
#    a device removed and re-added, or a driver rebind, is the case it is
#    insurance for.
# 2. Each QMAP link feeds the NSS, which takes the packets one by one from
#    the device's receive handler (package/nss/qca-nss-drv patch 0150), so
#    two things the stack does for a host-bound device are undone:
#    - GRO off: a segment GRO has merged can only go through the host stack,
#      so with GRO on most of the downlink would be forwarded in software
#      (31.5 CPU-s/GB with GRO, 15.3 without, same rate; commit fa02c60b49);
#    - RPS to the CPUs the modem's interrupts are not on: the MHI interrupts
#      and the deaggregation run on the last CPU, the hand-off to the NSS
#      then runs on the other one. Same CPU cost per GB as no RPS (12.1-12.5
#      vs 11.2-13.6 CPU-s/GB), but the loaded core drops from 13 % to 9 % at
#      90 Mbit/s, which lifts the ceiling by ~20 % (commit ef9190cd01). The
#      NSS default RPS mask would steer to the last CPU instead, the one the
#      packet is already on: a flow hash and a backlog queue per packet for
#      nothing (18.9 CPU-s/GB instead of 12.7).
# 3. The NSS-to-host delivery to the other core as well: nss-irq-affinity
#    reads where the modem's interrupts are and places nss_queue1 and the
#    N2H pri_map opposite, so it runs last here (it is the only writer of
#    those two). Before the NSS plane is armed it does nothing; the NSS
#    bring-up runs it again. Measured with both in place (5 GHz Wi-Fi,
#    ~205 Mbit/s): 10.4-10.9 -> 8.1-10.9 CPU-s/GB, busiest core 18 % ->
#    12-16 %, both cores evenly loaded as on the stock firmware (commit
#    c4facf0352).
#
# On a single CPU (maxcpus=1) there is nothing to pin and RPS is simply off
# (an empty mask); GRO off still matters and is done.
. /lib/cb0401v2-modem.sh
MODEM=$CB0401_MODEM_PCI
PROG=cb0401v2-wwan-affinity
log() { logger -t "$PROG" "$1"; }

ncpu=$(grep -c ^processor /proc/cpuinfo)
[ "$ncpu" -ge 1 ] || ncpu=1
last=$((ncpu - 1))
# every CPU but the last, as a hex mask
others=$(printf '%x' $(( (1 << last) - 1 )))

if [ "$last" -lt 1 ]; then
	: # one CPU: the interrupts have nowhere else to go
elif [ -d "$MODEM/msi_irqs" ]; then
	moved=''
	for f in "$MODEM"/msi_irqs/*; do
		[ -e "$f" ] || continue
		irq="${f##*/}"
		# allocated but never requested (MSI comes in powers of two, the
		# controller uses 7 of 8): no /proc/irq entry, nothing to pin
		[ -d "/proc/irq/$irq" ] || continue
		[ "$(cat "/proc/irq/$irq/smp_affinity_list" 2>/dev/null)" = "$last" ] && continue
		if echo "$last" > "/proc/irq/$irq/smp_affinity_list" 2>/dev/null; then
			moved="$moved $irq"
		else
			log "irq $irq: cannot pin to CPU$last"
		fi
	done
	[ -n "$moved" ] && log "modem MHI interrupts$moved -> CPU$last"
else
	log "modem not bound on PCIe1 - no interrupts to place"
fi

if [ $# -eq 0 ]; then
	for d in /sys/class/net/qmapmux*; do
		[ -e "$d" ] && set -- "$@" "${d##*/}"
	done
fi
for link; do
	[ -d "/sys/class/net/$link" ] || continue
	ethtool -K "$link" gro off >/dev/null 2>&1
	for q in /sys/class/net/"$link"/queues/rx-*/rps_cpus; do
		[ -e "$q" ] && echo "$others" > "$q"
	done
done

[ -x /usr/sbin/nss-irq-affinity ] && /usr/sbin/nss-irq-affinity
exit 0
