From: Balázs Gyimesi <gyimesi.balazs@gmail.com>
Subject: [PATCH] port-qmi: downlink aggregation sized for the mhi_net MRU

The 32768-byte / 32-datagram downlink aggregation asked of a PCIe modem
has to fit the receive buffers mhi_net hands the device, whose size is the
MHI controller's MRU (the 16 KiB MTU ModemManager sets on mhi_net plays no
part in the receive buffer size). On the Xiaomi CB0401 (RG520N on MHI)
mhi_net runs with a 32256-byte MRU (kernel patch 0914: the largest that
fits an order-3 page block with the buffer's headroom and skb_shared_info),
so ask for frames of 31744 bytes / 32 datagrams, which keeps every
aggregated frame inside one buffer even if the modem counts the MAP
headers on top (32 x 8 bytes of MAP + MAPv5 checksum header: 32000 <=
32256). (The stock firmware asks for 15360 / 20 on a 16 KiB MRU; the
larger frame measured 9 % less CPU per forwarded GB.)
---
--- a/src/mm-port-qmi.c
+++ b/src/mm-port-qmi.c
@@ -1230,6 +1230,12 @@
 #define DEFAULT_DOWNLINK_DATA_AGGREGATION_MAX_SIZE                32768
 #define DEFAULT_DOWNLINK_DATA_AGGREGATION_MAX_SIZE_QMI_WWAN_RMNET 16384
 #define DEFAULT_DOWNLINK_DATA_AGGREGATION_MAX_DATAGRAMS           32
+/* Xiaomi CB0401 (Quectel RG520N over MHI): fits the receive buffers mhi_net
+ * hands the modem, whose size is the MHI controller's MRU (32256 on this
+ * board, the kernel's; the mhi_net MTU, 16 KiB, is not involved on the
+ * receive side). 31744 + 32 x 8 bytes of MAP headers still fits. */
+#define DEFAULT_DOWNLINK_DATA_AGGREGATION_MAX_SIZE_MHI_NET        31744
+#define DEFAULT_DOWNLINK_DATA_AGGREGATION_MAX_DATAGRAMS_MHI_NET   32
 
 typedef struct {
     MMPortQmiKernelDataMode       kernel_data_mode;
@@ -1580,9 +1586,14 @@
         if ((g_strcmp0 (self->priv->net_driver, "qmi_wwan") == 0) &&
             (ctx->kernel_data_modes_supported & MM_PORT_QMI_KERNEL_DATA_MODE_MUX_RMNET))
             qmi_message_wda_set_data_format_input_set_downlink_data_aggregation_max_size (input, DEFAULT_DOWNLINK_DATA_AGGREGATION_MAX_SIZE_QMI_WWAN_RMNET, NULL);
+        else if (g_strcmp0 (self->priv->net_driver, "mhi_net") == 0)
+            qmi_message_wda_set_data_format_input_set_downlink_data_aggregation_max_size (input, DEFAULT_DOWNLINK_DATA_AGGREGATION_MAX_SIZE_MHI_NET, NULL);
         else
             qmi_message_wda_set_data_format_input_set_downlink_data_aggregation_max_size (input, DEFAULT_DOWNLINK_DATA_AGGREGATION_MAX_SIZE, NULL);
-        qmi_message_wda_set_data_format_input_set_downlink_data_aggregation_max_datagrams (input, DEFAULT_DOWNLINK_DATA_AGGREGATION_MAX_DATAGRAMS, NULL);
+        if (g_strcmp0 (self->priv->net_driver, "mhi_net") == 0)
+            qmi_message_wda_set_data_format_input_set_downlink_data_aggregation_max_datagrams (input, DEFAULT_DOWNLINK_DATA_AGGREGATION_MAX_DATAGRAMS_MHI_NET, NULL);
+        else
+            qmi_message_wda_set_data_format_input_set_downlink_data_aggregation_max_datagrams (input, DEFAULT_DOWNLINK_DATA_AGGREGATION_MAX_DATAGRAMS, NULL);
     }
     if (ctx->use_endpoint)
         qmi_message_wda_set_data_format_input_set_endpoint_info (input, self->priv->endpoint_type, self->priv->endpoint_interface_number, NULL);
