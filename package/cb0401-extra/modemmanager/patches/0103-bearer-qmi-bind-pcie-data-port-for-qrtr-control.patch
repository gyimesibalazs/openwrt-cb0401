+/* A QRTR based QMI control port is not implicitly tied to any data endpoint.
+ * When the data port is a PCIe/MHI netdev (e.g. a Quectel RG520N behind a
+ * Qualcomm IPQ SoC host, control over QRTR, data over mhi_net) the WDS client
+ * must be explicitly bound to the PCIe endpoint even without multiplexing,
+ * otherwise "Start Network" fails with InvalidOperation. Mux id 0 selects the
+ * plain (non-QMAP) data path. */
+static gboolean
+qrtr_pcie_bind_needed (ConnectContext *ctx)
+{
+    return (ctx->mux_id == QMI_DEVICE_MUX_ID_UNBOUND &&
+            ctx->endpoint.type == QMI_DATA_ENDPOINT_TYPE_PCIE &&
+            ctx->qmi &&
+            mm_port_get_subsys (MM_PORT (ctx->qmi)) == MM_PORT_SUBSYS_QRTR);
+}
