/dts-v1/;
/*
 * Xiaomi CB0401V2 (Magenta 5G AX5400 V2)
 *
 * Board: IPQ5018/AP-MP03.6-C1, 512 MiB RAM, 256 MiB SPI-NAND, QCN9074 on
 * PCIe0, Quectel RG520N (SDX62) on USB (and PCIe1). Pins, LEDs, buttons,
 * partitions and the switch layout follow the stock device tree of a V2 unit.
 *
 * The unit is secure-boot fused: it runs OpenWrt through U-Boot bootm from
 * the merged "ubi" partition, started by the ESP32-C3 rescue console (see
 * tools/cb0401/).
 *
 * Ethernet runs on the upstream stmmac/dwmac-ipq5018 stack: GMAC0 drives the
 * internal GE PHY (lan1), GMAC1 the UNIPHY SGMII link to the QCA8337 (lan2).
 * The NSS core is described by ipq5018-nss.dtsi.
 *
 * The IPQ5018 radio runs the multi-PD WLAN.HK.2.7.0.1 image with only user
 * PD 1 started (ipq5018-qcn6122.dtsi), as on the other QCN9074 boards: its
 * 2.4 GHz radio completes associations under NSS Wi-Fi offload and takes
 * more than one AP. The image is not signed (no IPQ5018 WCSS image is), the
 * fused TrustZone starts it like the stock 2.6 one. It has to run offloaded:
 * on the host path the first client frames crash ath11k.
 */

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-nss.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Xiaomi CB0401V2";
	compatible = "xiaomi,cb0401v2", "qcom,ipq5018";

	aliases {
		label-mac-device = &gmac0;
		led-boot = &led_sys_blue;
		led-failsafe = &led_sys_yellow;
		led-running = &led_sys_blue;
		led-upgrade = &led_sys_yellow;
		serial0 = &blsp1_uart1;
	};

	chosen {
		bootargs-append = " coherent_pool=2M pcie_port_pm=off";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";

		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset-button {
			label = "reset";
			gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};

		power-button {
			label = "power";
			gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led_sys_blue: sys-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>;
		};

		led_sys_yellow: sys-yellow {
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 35 GPIO_ACTIVE_HIGH>;
		};

		wifi {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_WLAN;
			gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
		};

		net-4g {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_WAN_ONLINE;
			function-enumerator = <4>;
			gpios = <&tlmm 26 GPIO_ACTIVE_HIGH>;
		};

		net-5g {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_WAN_ONLINE;
			function-enumerator = <5>;
			gpios = <&tlmm 27 GPIO_ACTIVE_HIGH>;
		};

		/*
		 * Not a real LED: the RG520N PWRKEY ("mb_onoff", gpio30), exposed the
		 * same way the stock firmware does it. /etc/init.d/modem-power pulses
		 * it high for 1 s at boot to switch the modem on, exactly like the
		 * stock /etc/init.d/boot.
		 */
		mb_onoff {
			label = "mb_onoff";
			gpios = <&tlmm 30 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};
};

/* The stock firmware reserves 4 MiB for TZ here, the SoC dtsi only 2 MiB */
&tz_region {
	reg = <0x0 0x4ac00000 0x0 0x400000>;
};

/*
 * Mirror the stock no-map regions the SoC dtsi does not know about, so the
 * usable RAM is exactly the stock /proc/iomem: 0x41000000-0x4a3fffff and
 * 0x4fd00000-0x5fffffff (the NSS region at 0x40000000 is in the SoC dtsi).
 * Engines left running by the stock firmware (QCN9074 firmware memory, dma
 * pools) may still touch these.
 */
&{/reserved-memory} {
	/*
	 * caldb tail, qcn9000_pcie0, dma_pool1, rsvd1, rsvd2; from above the
	 * multi-PD Q6 regions of ipq5018-qcn6122.dtsi (up to 0x4d200000)
	 */
	stock-rsvd@4d200000 {
		no-map;
		reg = <0x0 0x4d200000 0x0 0x2b00000>;
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";

	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&crypto {
	status = "okay";
};

&cryptobam {
	status = "okay";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

/*
 * Secure-boot unit: the QPIC BAM is configured by TrustZone (its TRUST/EE
 * registers are XPU-protected; reading them gives an external abort). The
 * driver must not software-reset it, or the first pipe access becomes a
 * fatal secure violation. NUM_PIPES read on stock: 0x07070009 (9 pipes),
 * REVISION 0x029BA419 (4 EEs).
 */
&qpic_bam {
	qcom,controlled-remotely;
	num-channels = <9>;
	qcom,num-ees = <4>;
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";
	/*
	 * Secure-boot unit: TZ locks NAND_FLASH_SPI_CFG / NUM_ADDR_CYCLES /
	 * BUSY_CHECK_WAIT_CNT (XPU: 0x79b00c0..0xc8) and has programmed them for
	 * the boot chain. The driver must not touch them.
	 */
	qcom,tz-locked-spi-cfg;

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:sbl1";
				reg = <0x00000000 0x80000>;
				read-only;
			};

			partition@80000 {
				label = "0:mibib";
				reg = <0x00080000 0x80000>;
				read-only;
			};

			partition@100000 {
				label = "0:bootconfig";
				reg = <0x00100000 0x40000>;
				read-only;
			};

			partition@140000 {
				label = "0:bootconfig1";
				reg = <0x00140000 0x40000>;
				read-only;
			};

			partition@180000 {
				label = "0:qsee";
				reg = <0x00180000 0x100000>;
				read-only;
			};

			partition@280000 {
				label = "0:qsee_1";
				reg = <0x00280000 0x100000>;
				read-only;
			};

			partition@380000 {
				label = "0:devcfg";
				reg = <0x00380000 0x40000>;
				read-only;
			};

			partition@3c0000 {
				label = "0:devcfg_1";
				reg = <0x003c0000 0x40000>;
				read-only;
			};

			partition@400000 {
				label = "0:cdt";
				reg = <0x00400000 0x40000>;
				read-only;
			};

			partition@440000 {
				label = "0:cdt_1";
				reg = <0x00440000 0x40000>;
				read-only;
			};

			partition@480000 {
				label = "0:appsblenv";
				reg = <0x00480000 0x80000>;
				read-only;
			};

			partition@500000 {
				label = "0:appsbl";
				reg = <0x00500000 0x140000>;
				read-only;
			};

			partition@640000 {
				label = "0:appsbl_1";
				reg = <0x00640000 0x140000>;
				read-only;
			};

			partition@780000 {
				label = "0:art";
				reg = <0x00780000 0x100000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					mac_addr_gmac0: macaddr@0 {
						reg = <0x0 0x6>;
					};

					mac_addr_gmac1: macaddr@6 {
						reg = <0x6 0x6>;
					};
				};
			};

			partition@880000 {
				label = "0:training";
				reg = <0x00880000 0x80000>;
				read-only;
			};

			partition@900000 {
				label = "bdata";
				reg = <0x00900000 0x80000>;
				read-only;
			};

			partition@980000 {
				label = "crash";
				reg = <0x00980000 0x80000>;
				read-only;
			};

			partition@a00000 {
				label = "crash_syslog";
				reg = <0x00a00000 0x80000>;
				read-only;
			};

			/*
			 * Dual boot. The stock system stays where U-Boot's bootmiwifi
			 * finds it (rootfs, rootfs_1, overlay), so the box boots the
			 * stock firmware without the rescue C3 or with an emptied
			 * environment. OpenWrt lives in the 147 MiB modem_image
			 * partition instead, as one UBI (kernel, rootfs and
			 * rootfs_data volumes); the C3 boots it with a RAM-only
			 * mtdparts "fs" over that range plus "ubi read kernel".
			 * modem_image only held the modem's firmware update package,
			 * which the stock firmware reads during its own system
			 * upgrade (such an upgrade would overwrite OpenWrt); keep a
			 * dump of it. The stock partitions are exposed under other
			 * names so that nothing mounts them, writable to restore them
			 * from a dump.
			 */
			partition@a80000 {
				label = "stock_rootfs";
				reg = <0x00a80000 0x1f00000>;
			};

			partition@2980000 {
				label = "stock_rootfs_1";
				reg = <0x02980000 0x1f00000>;
			};

			partition@4880000 {
				label = "stock_overlay";
				reg = <0x04880000 0x2140000>;
			};

			partition@69c0000 {
				label = "ubi";
				reg = <0x069c0000 0x93a0000>;
			};
		};
	};
};

/*
 * MAC0 -> GE PHY ---------------------------------- lan1
 * MAC1 -> UNIPHY -- SGMII -- QCA8337 port 6, PHY 0 -- lan2
 */

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_25MHZ>;
};

&gmac0 {
	status = "okay";

	label = "lan1";
	nvmem-cells = <&mac_addr_gmac0 0>;
	nvmem-cell-names = "mac-address";
};

&gmac1 {
	status = "okay";

	phy-mode = "sgmii";
	nvmem-cells = <&mac_addr_gmac1 0>;
	nvmem-cell-names = "mac-address";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;

	qca8337_0: ethernet-phy@0 {
		reg = <0>;
	};

	ethernet-switch@18 {
		compatible = "qca,qca8337";
		reg = <0x18>;
		#address-cells = <1>;
		#size-cells = <0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@1 {
				reg = <1>;
				label = "lan2";
				phy-handle = <&qca8337_0>;
			};

			port@6 {
				reg = <6>;
				phy-mode = "sgmii";
				ethernet = <&gmac1>;
				qca,sgmii-enable-pll;
				/* forced SGMII: qca8k turns SerDes AN off for a fixed-link CPU port */

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
	};
};

/*
 * NFC tag (FM11NT08 class, dual interface: the phone reads it over RF, we
 * write it over I2C) on BLSP1 QUP1, which the SoC dtsi does not describe.
 * The stock firmware stores a "tap to join WiFi" NDEF record in it; see
 * /usr/sbin/cb0401-nfc.
 */
&soc {
	blsp1_i2c1: i2c@78b5000 {
		compatible = "qcom,i2c-qup-v2.2.1";
		reg = <0x078b5000 0x600>;
		#address-cells = <1>;
		#size-cells = <0>;
		interrupts = <GIC_SPI 95 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&gcc GCC_BLSP1_QUP1_I2C_APPS_CLK>,
			 <&gcc GCC_BLSP1_AHB_CLK>;
		clock-names = "core", "iface";
		clock-frequency = <400000>;

		pinctrl-0 = <&i2c0_pins>;
		pinctrl-names = "default";
	};
};

&tlmm {
	button_pins: button-state {
		pins = "gpio24", "gpio38";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	i2c0_pins: i2c0-state {
		pins = "gpio12", "gpio13";
		function = "blsp0_i2c";
		drive-strength = <8>;
		bias-pull-up;
	};

	leds_pins: leds-state {
		pins = "gpio11", "gpio26", "gpio27", "gpio32", "gpio35";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	/* Stock defaults: power rails on, modem out of reset and not powered off */
	ge-power-hog {
		gpio-hog;
		gpios = <33 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "ge-power";
	};

	usb-power-hog {
		gpio-hog;
		gpios = <46 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "usb-power";
	};

	/*
	 * gpio34 "modem-reset" (active-high): hold LOW = modem OUT of reset, like
	 * stock. The RG520N is driven over USB (ttyUSB + qmi_wwan), and it only
	 * boots (and exposes its USB interface) when held out of reset.
	 */
	modem-reset-hog {
		gpio-hog;
		gpios = <34 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "modem-reset";
	};

	ap2mdm-status-hog {
		gpio-hog;
		gpios = <25 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "ap2mdm-status";
	};

	ap2mdm-gp-rst-n-hog {
		gpio-hog;
		gpios = <28 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "ap2mdm-gp-rst-n";
	};

	sdx-pon-hog {
		gpio-hog;
		gpios = <40 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "sdx-pon";
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio20", "gpio21";
		function = "blsp0_uart0";
		bias-disable;
	};
};

&pcie0_phy {
	status = "okay";
};

&pcie0 {
	status = "okay";

	perst-gpios = <&tlmm 15 GPIO_ACTIVE_LOW>;

	pcie@0 {
		wifi@0,0 {
			status = "okay";

			/* QCN9074: ath11k lacks DT compatible for PCI cards */
			compatible = "pci17cb,1104";
			reg = <0x00010000 0 0 0 0>;

			qcom,ath11k-calibration-variant = "Xiaomi-CB0401V2";
		};
	};
};

/*
 * PCIe link of the Quectel RG520N. The modem is driven over USB, as on
 * stock (see &usb); the link stays enabled like on the stock firmware.
 */
&pcie1_phy {
	status = "okay";
};

&pcie1 {
	status = "okay";

	/* stock DT uses the same polarity flag for both PERST lines */
	perst-gpios = <&tlmm 18 GPIO_ACTIVE_LOW>;
};

/*
 * USB 2.0 host (dwc3) with the RG520N on it: option ttyUSB AT ports and
 * qmi_wwan, like the stock firmware. usb-power-hog (gpio46) powers the port.
 */
&usbphy0 {
	status = "okay";
};

/* USB 2.0 only: no USB3 PHY, so clock the pipe from UTMI */
&usb {
	phys = <&usbphy0>;
	phy-names = "usb2-phy";
	dr_mode = "host";
	qcom,select-utmi-as-pipe-clk;

	status = "okay";
};

&wifi {
	status = "okay";

	qcom,rproc = <&q6v5_wcss>;
	qcom,ath11k-calibration-variant = "Xiaomi-CB0401V2";
	qcom,ath11k-fw-memory-mode = <1>;
};
