/dts-v1/;
/*
 * Xiaomi CB0401 (the original, non-V2 5G CPE)
 *
 * Board: IPQ5018/AP-MP03.6-C1, 128 MiB SPI-NAND, QCN9074 on PCIe0, a
 * 5G modem (the same Quectel RG520N, 17cb:0308, as the V2) on PCIe1. Same
 * reference design as the CB0401V2, so pins, LEDs, buttons, the switch layout
 * and the modem are shared; the flash layout differs.
 *
 * EXPERIMENTAL. The hardware here follows a CB0401 owner's OpenWrt DTS that
 * was tested on a real unit (WiFi, both LAN ports and the modem working): fw
 * memory mode 1, no TrustZone NAND quirks (unlike the V2, this unit's QPIC is
 * not locked), the SGMII link without forced no-autoneg, and the modem
 * powered on by pulsing gpio30. The RAM (1 GB) is left to the bootloader
 * (U-Boot fixes up the memory node from SMEM at bootm); no reserved-memory is
 * pinned here, so if a unit shows stock engines clobbering RAM, its
 * /proc/iomem no-map regions would need adding.
 *
 * The unit is secure-boot fused: it runs OpenWrt through U-Boot bootm. The
 * merged "ubi" partition (stock rootfs + rootfs_1 + overlay) and the ESP32-C3
 * rescue console are this port's own choice, for a full-space, sysupgradeable
 * install; see tools/cb0401/.
 */

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-nss.dtsi"
#include "ipq5018-q6-fixed-mem.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Xiaomi CB0401";
	compatible = "xiaomi,cb0401", "qcom,ipq5018";

	aliases {
		label-mac-device = &gmac0;
		led-boot = &led_sys_blue;
		led-failsafe = &led_sys_yellow;
		led-running = &led_sys_blue;
		led-upgrade = &led_sys_yellow;
		serial0 = &blsp1_uart1;
	};

	chosen {
		bootargs-append = " coherent_pool=2M pcie_port_pm=off";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";

		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset-button {
			label = "reset";
			gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};

		power-button {
			label = "power";
			gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led_sys_blue: sys-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>;
		};

		led_sys_yellow: sys-yellow {
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 35 GPIO_ACTIVE_HIGH>;
		};

		wifi {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_WLAN;
			gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
		};

		net-4g {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_WAN_ONLINE;
			function-enumerator = <4>;
			gpios = <&tlmm 26 GPIO_ACTIVE_HIGH>;
		};

		net-5g {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_WAN_ONLINE;
			function-enumerator = <5>;
			gpios = <&tlmm 27 GPIO_ACTIVE_HIGH>;
		};

		/*
		 * Not a real LED: the modem PWRKEY ("mb_onoff", gpio30), exposed the
		 * way the stock firmware uses it. cb0401v2-modem pulses it high
		 * for 1 s at boot to switch the modem on; holding it high (hogging it)
		 * powers the modem off, so it must be a pulse, not a hog.
		 */
		mb_onoff {
			label = "mb_onoff";
			gpios = <&tlmm 30 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";

	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&crypto {
	status = "okay";
};

&cryptobam {
	status = "okay";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:sbl1";
				reg = <0x00000000 0x80000>;
				read-only;
			};

			partition@80000 {
				label = "0:mibib";
				reg = <0x00080000 0x80000>;
				read-only;
			};

			partition@100000 {
				label = "0:bootconfig";
				reg = <0x00100000 0x40000>;
				read-only;
			};

			partition@140000 {
				label = "0:bootconfig1";
				reg = <0x00140000 0x40000>;
				read-only;
			};

			partition@180000 {
				label = "0:qsee";
				reg = <0x00180000 0x100000>;
				read-only;
			};

			partition@280000 {
				label = "0:qsee_1";
				reg = <0x00280000 0x100000>;
				read-only;
			};

			partition@380000 {
				label = "0:devcfg";
				reg = <0x00380000 0x40000>;
				read-only;
			};

			partition@3c0000 {
				label = "0:devcfg_1";
				reg = <0x003c0000 0x40000>;
				read-only;
			};

			partition@400000 {
				label = "0:cdt";
				reg = <0x00400000 0x40000>;
				read-only;
			};

			partition@440000 {
				label = "0:cdt_1";
				reg = <0x00440000 0x40000>;
				read-only;
			};

			partition@480000 {
				label = "0:appsblenv";
				reg = <0x00480000 0x80000>;
				read-only;
			};

			partition@500000 {
				label = "0:appsbl";
				reg = <0x00500000 0x140000>;
				read-only;
			};

			partition@640000 {
				label = "0:appsbl_1";
				reg = <0x00640000 0x140000>;
				read-only;
			};

			partition@780000 {
				label = "0:art";
				reg = <0x00780000 0x100000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					mac_addr_gmac0: macaddr@0 {
						reg = <0x0 0x6>;
					};

					mac_addr_gmac1: macaddr@6 {
						reg = <0x6 0x6>;
					};
				};
			};

			partition@880000 {
				label = "0:training";
				reg = <0x00880000 0x80000>;
				read-only;
			};

			partition@900000 {
				label = "bdata";
				reg = <0x00900000 0x80000>;
				read-only;
			};

			partition@980000 {
				label = "crash";
				reg = <0x00980000 0x80000>;
				read-only;
			};

			partition@a00000 {
				label = "crash_syslog";
				reg = <0x00a00000 0x80000>;
				read-only;
			};

			/*
			 * The stock rootfs, rootfs_1 and overlay partitions are
			 * contiguous; OpenWrt uses them as one UBI (kernel, rootfs and
			 * rootfs_data volumes). U-Boot keeps its own MIBIB view (three
			 * partitions); the rescue C3 boots it with a RAM-only mtdparts
			 * "fs" over the same range plus "ubi read kernel".
			 */
			partition@a80000 {
				label = "ubi";
				reg = <0x00a80000 0x7300000>;
			};
		};
	};
};

/*
 * MAC0 -> GE PHY ---------------------------------- lan1
 * MAC1 -> UNIPHY -- SGMII -- QCA8337 port 6, PHY 0 -- wan
 */

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_25MHZ>;
};

&gmac0 {
	status = "okay";

	label = "lan1";
	nvmem-cells = <&mac_addr_gmac0 0>;
	nvmem-cell-names = "mac-address";
};

&gmac1 {
	status = "okay";

	phy-mode = "sgmii";
	nvmem-cells = <&mac_addr_gmac1 0>;
	nvmem-cell-names = "mac-address";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;

	qca8337_0: ethernet-phy@0 {
		reg = <0>;
	};

	ethernet-switch@18 {
		compatible = "qca,qca8337";
		reg = <0x18>;
		#address-cells = <1>;
		#size-cells = <0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@1 {
				reg = <1>;
				label = "wan";
				phy-handle = <&qca8337_0>;
			};

			port@6 {
				reg = <6>;
				phy-mode = "sgmii";
				ethernet = <&gmac1>;
				qca,sgmii-enable-pll;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
	};
};

/*
 * NFC tag (FM11NT08 class, dual interface: the phone reads it over RF, we
 * write it over I2C) on BLSP1 QUP1, which the SoC dtsi does not describe.
 * The stock firmware stores a "tap to join WiFi" NDEF record in it; see
 * /usr/sbin/cb0401-nfc.
 */
&soc {
	blsp1_i2c1: i2c@78b5000 {
		compatible = "qcom,i2c-qup-v2.2.1";
		reg = <0x078b5000 0x600>;
		#address-cells = <1>;
		#size-cells = <0>;
		interrupts = <GIC_SPI 95 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&gcc GCC_BLSP1_QUP1_I2C_APPS_CLK>,
			 <&gcc GCC_BLSP1_AHB_CLK>;
		clock-names = "core", "iface";
		clock-frequency = <400000>;

		pinctrl-0 = <&i2c0_pins>;
		pinctrl-names = "default";
	};
};

&tlmm {
	button_pins: button-state {
		pins = "gpio24", "gpio38";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	i2c0_pins: i2c0-state {
		pins = "gpio12", "gpio13";
		function = "blsp0_i2c";
		drive-strength = <8>;
		bias-pull-up;
	};

	leds_pins: leds-state {
		pins = "gpio11", "gpio26", "gpio27", "gpio32", "gpio35";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	/*
	 * Modem lines as on the stock firmware, confirmed on a real unit:
	 * usb-power and ap2mdm-reset-n held high, sdx-pon held low. gpio30
	 * (mb_onoff) is a momentary PWRKEY and is pulsed from userspace at boot
	 * (cb0401v2-modem), not hogged.
	 */
	usb-power-hog {
		gpio-hog;
		gpios = <46 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "usb-power";
	};

	ap2mdm-reset-n-hog {
		gpio-hog;
		gpios = <28 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "ap2mdm-reset-n";
	};

	sdx-pon-hog {
		gpio-hog;
		gpios = <40 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "sdx-pon";
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio20", "gpio21";
		function = "blsp0_uart0";
		bias-disable;
	};
};

&pcie0_phy {
	status = "okay";
};

&pcie0 {
	status = "okay";

	perst-gpios = <&tlmm 15 GPIO_ACTIVE_LOW>;

	pcie@0 {
		wifi@0,0 {
			status = "okay";

			/* QCN9074: ath11k lacks DT compatible for PCI cards */
			compatible = "pci17cb,1104";
			reg = <0x00010000 0 0 0 0>;

			qcom,ath11k-calibration-variant = "Xiaomi-CB0401";
		};
	};
};

/*
 * PCIe link of the 5G modem: a Quectel RG520N (17cb:0308) as on the V2,
 * data over MHI, AT ports over USB (ttyUSB0-3). Confirmed on a unit.
 */
&pcie1_phy {
	status = "okay";
};

&pcie1 {
	status = "okay";

	/* stock DT uses the same polarity flag for both PERST lines */
	perst-gpios = <&tlmm 18 GPIO_ACTIVE_LOW>;
};

/*
 * USB 2.0 host (dwc3), kept enabled like the stock firmware.
 */
&usbphy0 {
	status = "okay";
};

/* USB 2.0 only: no USB3 PHY, so clock the pipe from UTMI */
&usb {
	phys = <&usbphy0>;
	phy-names = "usb2-phy";
	dr_mode = "host";
	qcom,select-utmi-as-pipe-clk;

	status = "okay";
};

&q6v5_wcss {
	firmware-name = "ath11k/IPQ5018/hw1.0/q6_fw.mdt",
			"ath11k/IPQ5018/hw1.0/m3_fw.mdt";
};

&wifi {
	status = "okay";

	qcom,rproc = <&q6v5_wcss>;
	qcom,ath11k-calibration-variant = "Xiaomi-CB0401";
	/* fw memory mode 1, confirmed working on a real CB0401 unit */
	qcom,ath11k-fw-memory-mode = <1>;
};
