#!/bin/sh
# Xiaomi CB0401 / CB0401V2: ModemManager creates a QMAP link per connection.
# Each needs GRO off and RPS away from the modem's core, and the NSS-to-host
# delivery placed opposite the modem - cb0401v2-wwan-affinity (package
# xiaomi-cb0401v2-modem) owns all of that, the measurements are there; it
# also re-pins the modem's interrupts, so a reconnect after a modem reset
# puts everything back. nss_queue1 and pri_map are not written here:
# nss-irq-affinity, which that script ends with, is their only writer.
# In the background: that step can wait on the NSS firmware (up to 6 s per
# message when it does not answer), and the net hotplug events behind this
# one must not.
[ "$ACTION" = add ] || exit 0
case "$DEVICENAME" in
qmapmux*) ;;
*) exit 0 ;;
esac
. /lib/functions.sh
case "$(board_name)" in
xiaomi,cb0401|xiaomi,cb0401v2)
	[ -x /usr/sbin/cb0401v2-wwan-affinity ] &&
		/usr/sbin/cb0401v2-wwan-affinity "$DEVICENAME" </dev/null >/dev/null 2>&1 &
	;;
esac
exit 0
