#!/bin/sh
# Xiaomi CB0401V2: 5G modem (Quectel RG520N-EB) on PCIe/MHI, as on stock:
# ModemManager (qcom-soc plugin) controls it over QMI on QRTR, data runs on
# the raw-IP mhi_hwip0 netdev. Needs the modem's data path on PCIe, the stock
# setting: AT+QCFG="data_interface",1,0.
. /lib/functions.sh
[ "$(board_name)" = xiaomi,cb0401v2 ] || exit 0

uci -q batch <<EOT
set network.wwan=interface
set network.wwan.proto='modemmanager'
set network.wwan.device='qcom-soc'
set network.wwan.apn='online'
set network.wwan.iptype='ipv4v6'
EOT
uci commit network

wan_zone=$(uci -q show firewall | sed -n "s/^firewall\.\([^.]*\)\.name='wan'$/\1/p")
[ -n "$wan_zone" ] && {
	uci -q del_list firewall.$wan_zone.network='wwan'
	uci add_list firewall.$wan_zone.network='wwan'
	uci commit firewall
}
exit 0
