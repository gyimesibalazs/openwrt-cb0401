#!/bin/sh
# Xiaomi CB0401 / CB0401V2: the IPQ5018 radio runs the multi-PD
# WLAN.HK.2.7.0.1 image, which has to stay under NSS Wi-Fi offload (on the
# host path the first client frames crash ath11k). Earlier images kept it on
# the host path with wifi_offload_ahb=0; drop that from kept settings.
. /lib/functions.sh
case "$(board_name)" in
xiaomi,cb0401|xiaomi,cb0401v2)
	[ "$(uci -q get nss.general.wifi_offload_ahb)" = 0 ] || exit 0
	uci -q delete nss.general.wifi_offload_ahb
	uci commit nss
	;;
esac
exit 0
