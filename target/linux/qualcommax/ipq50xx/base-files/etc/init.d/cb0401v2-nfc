#!/bin/sh /etc/rc.common
# Xiaomi CB0401 / CB0401V2: keep the NFC "tap to join WiFi" tag in sync with the
# wireless config (see /usr/sbin/cb0401v2-nfc)
START=99
USE_PROCD=1

start_service() {
	case "$(board_name)" in xiaomi,cb0401|xiaomi,cb0401v2) ;; *) return 0 ;; esac
	/usr/sbin/cb0401v2-nfc update
}

reload_service() {
	case "$(board_name)" in xiaomi,cb0401|xiaomi,cb0401v2) ;; *) return 0 ;; esac
	/usr/sbin/cb0401v2-nfc update
}

service_triggers() {
	case "$(board_name)" in xiaomi,cb0401|xiaomi,cb0401v2) ;; *) return 0 ;; esac
	procd_add_reload_trigger "wireless" "nfc"
}
