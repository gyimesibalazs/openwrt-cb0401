#!/bin/sh
# Xiaomi CB0401V2 NFC tag: write a "tap to join WiFi" NDEF record (WiFi Simple
# Config credential, application/vnd.wfa.wsc), like the stock firmware does,
# optionally followed by a URI record (iOS ignores the WiFi one).
#
# The tag is an FM11NT08-class dual interface tag on I2C: 2-byte byte address,
# 4-byte pages, NDEF TLV area from 0x0010 (stock /sbin/nfc, fm_i2c_update).
#
#   cb0401v2-nfc update        write the network from /etc/config/nfc
#   cb0401v2-nfc clear         write an empty NDEF message
#   cb0401v2-nfc dump [len]    print the NDEF area
#
# /etc/config/nfc:  config nfc 'nfc'
#                       option enabled '1'
#                       option iface ''   (wifi-iface section; empty = first
#                                          enabled AP with psk/sae or open)
#                       option url ''     (optional URI record, e.g. for iOS)

NDEF_START=0x10

log() { logger -t cb0401v2-nfc "$*"; echo "$*" >&2; }

find_tag() {
	local bus addr

	for bus in $(i2cdetect -l 2>/dev/null | sed -n 's/^i2c-\([0-9]*\).*/\1/p'); do
		for addr in 0x57 0x54; do
			i2ctransfer -y "$bus" w2@$addr 0x00 0x00 r1 >/dev/null 2>&1 || continue
			BUS=$bus ADDR=$addr
			[ "$addr" = 0x57 ] && return 0
			log "NXP tag at $addr is not supported (FM11NT08 only)"
			return 1
		done
	done
	log "no NFC tag found on I2C"
	return 1
}

# hexbytes <string>: "0xNN 0xNN ..." for every byte
hexbytes() { printf %s "$1" | hexdump -v -e '/1 "0x%02x "'; }
# be16 <n>: two big-endian bytes
be16() { printf "0x%02x 0x%02x " $(($1 >> 8)) $(($1 & 0xff)); }
# attr <id> <bytes...>: WSC TLV with 16-bit id and length
attr() { local id=$1; shift; be16 "$id"; be16 $#; echo -n "$* "; }
count() { echo $#; }

# wsc_credential <ssid> <auth> <encr> <key>
wsc_credential() {
	local cred

	cred="$(attr 0x1026 0x01)"
	cred="$cred$(attr 0x1045 $(hexbytes "$1"))"
	cred="$cred$(attr 0x1003 $(be16 $2))"
	cred="$cred$(attr 0x100f $(be16 $3))"
	cred="$cred$(attr 0x1027 $(hexbytes "$4"))"
	cred="$cred$(attr 0x1020 0xff 0xff 0xff 0xff 0xff 0xff)"
	attr 0x100e $cred
}

# record <flags> <tnf> <type> <payload bytes...>: one short NDEF record;
# flags are MB (0x80) / ME (0x40), SR is always set
record() {
	local hdr=$(($1 | 0x10 | $2)) type

	type=$(hexbytes "$3")
	shift 3
	[ $# -le 255 ] || { log "record too long"; return 1; }
	echo "$(printf "0x%02x 0x%02x 0x%02x" $hdr $(count $type) $#) $type $*"
}

# uri_payload <url>: NFC Forum URI record payload (abbreviated scheme)
uri_payload() {
	local url=$1 code=0x00

	case "$url" in
	http://www.*)	code=0x01; url=${url#http://www.} ;;
	https://www.*)	code=0x02; url=${url#https://www.} ;;
	http://*)	code=0x03; url=${url#http://} ;;
	https://*)	code=0x04; url=${url#https://} ;;
	esac
	echo "$code $(hexbytes "$url")"
}

# ndef_tlv <message bytes...>: NDEF TLV with 1- or 3-byte length
ndef_tlv() {
	if [ $# -lt 255 ]; then
		echo "0x03 $(printf "0x%02x" $#) $* 0xfe"
	else
		echo "0x03 0xff $(be16 $#)$* 0xfe"
	fi
}

# pick_iface: echo the wifi-iface section to advertise
pick_iface() {
	local want s

	want=$(uci -q get nfc.nfc.iface)
	[ -n "$want" ] && { echo "$want"; return; }
	for s in $(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
		[ "$(uci -q get wireless.$s.mode)" = ap ] || continue
		[ "$(uci -q get wireless.$s.disabled)" = 1 ] && continue
		echo "$s"
		return
	done
}

# wifi_credential: WSC credential of the shared AP, or nothing
wifi_credential() {
	local s ssid key enc auth encr

	s=$(pick_iface)
	[ -n "$s" ] || { log "no enabled WiFi AP to advertise"; return; }
	ssid=$(uci -q get wireless.$s.ssid)
	key=$(uci -q get wireless.$s.key)
	enc=$(uci -q get wireless.$s.encryption)

	case "$enc" in
	none|"")	auth=0x0001; encr=0x0001; key= ;;
	psk2*|sae-mixed*) auth=0x0020; encr=0x0008 ;;
	psk-mixed*)	auth=0x0022; encr=0x000c ;;
	*)		log "$s: encryption '$enc' cannot be shared over NFC"; return ;;
	esac

	log "advertising '$ssid' ($s, $enc)"
	wsc_credential "$ssid" $auth $encr "$key"
}

# build_message: WiFi credential record (Android joins the network) followed
# by an optional URI record (iOS only acts on URIs; opens it in Safari)
build_message() {
	local cred url wsc uri

	cred=$(wifi_credential)
	url=$(uci -q get nfc.nfc.url)
	[ -n "$cred" ] || [ -n "$url" ] || return 1

	if [ -n "$cred" ]; then
		wsc=$(record $([ -n "$url" ] && echo 0x80 || echo 0xc0) 0x02 \
			"application/vnd.wfa.wsc" $cred) || return 1
	fi
	if [ -n "$url" ]; then
		log "URL record: $url"
		uri=$(record $([ -n "$cred" ] && echo 0x40 || echo 0xc0) 0x01 \
			"U" $(uri_payload "$url")) || return 1
	fi
	ndef_tlv $wsc $uri
}

# ensure_cc: the capability container (page 3) must announce an NDEF tag or
# the phone ignores it; write the stock value into a blank one
ensure_cc() {
	local cc

	cc=$(i2ctransfer -y "$BUS" w2@$ADDR 0x00 0x0c r4 2>/dev/null)
	case "$cc" in
	0xe1*)	;;
	*)	log "capability container '$cc', writing the stock one"
		i2ctransfer -y "$BUS" w6@$ADDR 0x00 0x0c 0xe1 0x10 0x6d 0x00 ;;
	esac
}

# write_tag <bytes...>: 4-byte pages from NDEF_START, then read back
write_tag() {
	local addr=$NDEF_START n=$# page try back want

	want="$*"
	while [ $# -gt 0 ]; do
		page="$1 ${2:-0x00} ${3:-0x00} ${4:-0x00}"
		if [ $# -ge 4 ]; then shift 4; else shift $#; fi
		# the EEPROM NACKs while a page write is in progress; spawning
		# i2ctransfer again takes longer than that, so just retry
		for try in 1 2 3 4 5; do
			i2ctransfer -y "$BUS" w6@$ADDR $(be16 $addr) $page 2>/dev/null && break
		done
		addr=$((addr + 4))
	done

	back=$(i2ctransfer -y "$BUS" w2@$ADDR $(be16 $NDEF_START) r$n 2>/dev/null)
	[ "$back" = "$want" ] || { log "verify failed"; return 1; }
	log "wrote $n bytes"
}

case "$1" in
update)
	find_tag || exit 1
	ensure_cc
	if [ "$(uci -q get nfc.nfc.enabled)" = 0 ]; then
		write_tag 0x03 0x00 0xfe
	else
		# nothing shareable: clear the tag rather than leave stale credentials
		msg=$(build_message) || msg="0x03 0x00 0xfe"
		write_tag $msg
	fi
	;;
clear)
	find_tag && write_tag 0x03 0x00 0xfe
	;;
dump)
	find_tag && i2ctransfer -y "$BUS" w2@$ADDR $(be16 $NDEF_START) r${2:-128}
	;;
*)
	echo "usage: $0 update|clear|dump [len]" >&2
	exit 1
	;;
esac
