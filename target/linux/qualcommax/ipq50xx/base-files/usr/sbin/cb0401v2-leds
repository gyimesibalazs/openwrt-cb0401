#!/bin/sh
# Xiaomi CB0401 / CB0401V2 front LEDs, same scheme as the stock firmware
# (/lib/mobile.d/01-signal_led.sh + /etc/config/xqled):
#   4G   on = LTE connected, good signal; slow blink = weak signal
#   5G   on = 5G (NSA or SA) connected, good signal; slow blink = weak
#        (only one of 4G/5G is lit; both off while the WAN is down)
#   WiFi on = at least one WiFi interface is up
# Signal comes from ModemManager (the modem is on PCIe, QMI over QRTR), so
# the AT port stays free for luci-app-3ginfo-lite / modemband.
#
# The WiFi and WAN state are read from sysfs and netifd every INTERVAL
# seconds, which is cheap. The signal costs one mmcli run (a glib/D-Bus
# client, by far the most expensive step) and makes ModemManager poll the
# modem over QMI at the same rate, so it is sampled less often: every
# network.wwan.signalrate seconds when that option is set (the modemmanager
# proto handler then enables the polling itself, and this script keeps to
# the same rate instead of overriding it), else every SIGNAL_INTERVAL
# seconds. The value is read when the WAN comes up, so a changed signalrate
# takes effect once netifd restarts the interface (reload_config, ifup wwan).

WEAK_RSRP=-110		# dBm: below this the LED blinks
INTERVAL=10		# s, WiFi / WAN link state
SIGNAL_INTERVAL=30	# s, signal, unless network.wwan.signalrate is set

LED4=/sys/class/leds/white:wan-online-4
LED5=/sys/class/leds/white:wan-online-5
LEDW=/sys/class/leds/white:wlan

# set_led <led> on|off|blink, only when it changes (a rewrite restarts blink)
set_led() {
	local led="$1" mode="$2" var cur

	# the last state of each LED lives in a variable, mapped without forks
	case "$led" in
	"$LED4")	var=state_4 ;;
	"$LED5")	var=state_5 ;;
	*)		var=state_w ;;
	esac
	eval cur=\$$var
	[ "$cur" = "$mode" ] && return
	eval $var=$mode

	case "$mode" in
	on)	echo none > "$led/trigger"; echo 1 > "$led/brightness" ;;
	off)	echo none > "$led/trigger"; echo 0 > "$led/brightness" ;;
	blink)	echo timer > "$led/trigger"
		echo 1000 > "$led/delay_on"; echo 1000 > "$led/delay_off" ;;
	esac
}

# signal_led <led> <rsrp>
signal_led() {
	if [ -n "$2" ] && [ "${2%.*}" -lt "$WEAK_RSRP" ]; then
		set_led "$1" blink
	else
		set_led "$1" on
	fi
}

# valid_rsrp <value>: a decimal dBm figure; no carrier of that kind reads
# -32768 (and an unset value may print as "--")
valid_rsrp() {
	case "$1" in
	-[0-9]*|[0-9]*) case "$1" in *[!0-9.-]*) return 1 ;; esac ;;
	*) return 1 ;;
	esac
	[ "${1%.*}" -gt -200 ] 2>/dev/null
}

wifi_up() {
	local dev st

	for dev in /sys/class/net/*; do
		[ -e "$dev/phy80211" ] || continue
		read -r st 2>/dev/null < "$dev/operstate" && [ "$st" = up ] && return 0
	done
	return 1
}

# the same status blob ifstatus prints, without the extra sh and ubus list
wwan_up() {
	case "$(ubus call network.interface.wwan status 2>/dev/null)" in
	*'"up": true'*) return 0 ;;
	esac
	return 1
}

# read_signal: nr / lte = RSRP in dBm of that carrier, empty when absent
read_signal() {
	local line val

	nr= lte=
	while IFS= read -r line; do
		case "$line" in
		modem.signal.5g.rsrp[' :']*|modem.signal.lte.rsrp[' :']*) ;;
		*) continue ;;
		esac
		val=${line#*:}
		val=${val#"${val%%[! ]*}"}
		valid_rsrp "$val" || val=
		case "$line" in
		modem.signal.5g.*)	nr=$val ;;
		*)			lte=$val ;;
		esac
	done <<EOF
$(mmcli -m any --signal-get -K 2>/dev/null)
EOF
}

setup=0 tick=0 ticks=1 nr= lte=
while :; do
	if wifi_up; then set_led "$LEDW" on; else set_led "$LEDW" off; fi

	if wwan_up; then
		if [ "$setup" != 1 ]; then
			# extended signal info needs polling enabled once per modem
			rate=$(uci -q get network.wwan.signalrate)
			[ "$rate" -gt 0 ] 2>/dev/null || rate=$SIGNAL_INTERVAL
			ticks=$(( (rate + INTERVAL - 1) / INTERVAL ))
			mmcli -m any --signal-setup=$rate >/dev/null 2>&1 && setup=1 && tick=0
		fi
		if [ "$tick" -le 0 ]; then
			read_signal
			# nothing read (the first poll has not returned yet, or
			# mmcli failed): try again on the next pass, not a whole
			# signal period later with the WAN LEDs dark
			if [ -n "$nr$lte" ]; then tick=$ticks; else tick=1; fi
		fi
		tick=$((tick - 1))
	else
		setup=0 tick=0 nr= lte=
	fi

	if [ -n "$nr" ]; then
		set_led "$LED4" off
		signal_led "$LED5" "$nr"
	elif [ -n "$lte" ]; then
		set_led "$LED5" off
		signal_led "$LED4" "$lte"
	else
		set_led "$LED4" off
		set_led "$LED5" off
	fi

	sleep "$INTERVAL"
done
